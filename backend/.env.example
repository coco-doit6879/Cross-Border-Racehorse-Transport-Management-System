PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/cbrt_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Storage Config (Placeholder)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# VNPAY Sandbox. Never commit real credentials.
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:5000

# New bookings require this deposit before approval. Unpaid deposit holds expire automatically.
ORDER_DEPOSIT_PERCENT=20
ORDER_DEPOSIT_WINDOW_MINUTES=30
